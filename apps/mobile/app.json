{
  "expo": {
    "name": "Sematra",
    "slug": "petra-health",
    "version": "0.1.3",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "petrahealth",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petrapharma.health",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Sematra uses Face ID to unlock the app.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.petrapharma.health",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 3
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sematra uses Face ID to unlock the app."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ar",
              "ckb"
            ],
            "android": [
              "en",
              "ar",
              "ckb"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sematra uses your location once, during setup, so your care team knows your area."
        }
      ],
      "expo-router",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-updates",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "43e3843e-a614-4a66-bc53-f7772185640f"
      }
    },
    "owner": "mohammedshukur",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
