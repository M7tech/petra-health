{
  "expo": {
    "name": "Petra Health",
    "slug": "petra-health",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "petrahealth",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petrapharma.health",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Petra Health uses Face ID to unlock the app."
      }
    },
    "android": {
      "package": "com.petrapharma.health",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#a4225f"
      }
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Petra Health uses Face ID to unlock the app."
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#a4225f"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "43e3843e-a614-4a66-bc53-f7772185640f"
      }
    },
    "owner": "mohammedshukur"
  }
}
