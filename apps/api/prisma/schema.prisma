// Petra Health — data model
// Location hierarchy (Country -> City -> Doctor) uses enforced FKs.
// Semetra titration is modeled as Medication -> Pen -> TitrationWeek so the
// weekly checklist in the patient guide maps directly onto DoseLog rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Location hierarchy + provider directory
// ---------------------------------------------------------------------------

model Country {
  id        String   @id @default(uuid())
  name      String
  isoCode   String   @unique // e.g. "IQ"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities  City[]
  doctors Doctor[]

  @@map("countries")
}

model City {
  id        String   @id @default(uuid())
  name      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors Doctor[]
  users   User[]
  // Managers (EDITOR admins) assigned to oversee this city's doctors/patients.
  managers Admin[] @relation("ManagerCities")

  @@unique([countryId, name])
  @@index([countryId])
  @@map("cities")
}

model Doctor {
  id        String   @id @default(uuid())
  fullName  String
  specialty String?
  phone     String?
  // Optional login credentials so a doctor can access the portal.
  email        String? @unique
  passwordHash String?
  // Manager (EDITOR admin) who oversees this doctor.
  managerId    String?
  manager      Admin?  @relation("ManagerDoctors", fields: [managerId], references: [id], onDelete: SetNull)
  // Doctor -> City -> Country, both FKs enforced for relational integrity.
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients    User[]
  assessments ClinicalAssessment[]
  comments    PatientComment[]

  @@index([cityId])
  @@index([countryId])
  @@map("doctors")
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  // Health profile
  phone            String?
  birthDate        DateTime?
  gender           Gender?
  heightCm         Float?
  chronicConditions String[] @default([]) // condition keys, e.g. ["diabetes"]
  otherConditions  String?
  pushToken        String? // Expo push token, registered from a dev/production build (not Expo Go)
  // Real device GPS location, captured once during first-login onboarding.
  latitude           Float?
  longitude          Float?
  locationCapturedAt DateTime?
  // Chosen during hierarchical onboarding.
  countryId    String?
  cityId       String?
  city         City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  doctorId     String?
  doctor       Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  medications   UserMedication[]
  doseLogs      DoseLog[]
  weightEntries WeightEntry[]
  hba1cEntries  Hba1cEntry[]
  adverseEvents AdverseEvent[]
  comments      PatientComment[]
  assessment    ClinicalAssessment?
  messages      SupportMessage[]

  @@map("users")
}

// HbA1c measurements over time (baseline + monthly/3-monthly follow-up).
model Hba1cEntry {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value      Float // percent
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, recordedAt])
  @@map("hba1c_entries")
}

// Support thread between a patient and Petra Health admins.
model SupportMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    String // 'PATIENT' | 'ADMIN'
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("support_messages")
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum TreatmentStatus {
  ONGOING
  COMPLETED
  DISCONTINUED
}

enum AdverseSeverity {
  MILD
  MODERATE
  SEVERE
}

// One clinical follow-up record per patient, maintained by the doctor.
model ClinicalAssessment {
  id                    String          @id @default(uuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId              String?
  doctor                Doctor?         @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  assessmentDate        DateTime        @default(now())
  diabetesDuration      String? // e.g. "5 years"
  baselineHba1c         Float? // %
  startingDose          String? // e.g. "0.25 mg"
  concomitantMeds       String?
  treatmentStatus       TreatmentStatus @default(ONGOING)
  discontinuationReason String?
  physicianComments     String?
  updatedAt             DateTime        @updatedAt

  @@map("clinical_assessments")
}

// Patient-logged adverse events (time series alongside weight).
model AdverseEvent {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  severity    AdverseSeverity @default(MILD)
  onsetDate   DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([userId, onsetDate])
  @@map("adverse_events")
}

// Doctor comments on a patient (general, or tied to a weight entry).
model PatientComment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  body          String
  weightEntryId String? // optional link to a specific weight entry
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@map("patient_comments")
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  fullName     String
  officeName   String?
  role         AdminRole @default(EDITOR)
  // WhatsApp number (E.164, e.g. +9647500000000) — OTP/reset codes are sent
  // here via the WhatsApp Business Cloud API instead of email.
  whatsappPhone String?
  // OTP (2FA) + password reset
  otpHash        String?
  otpExpiresAt   DateTime?
  resetTokenHash String?
  resetExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Doctors this manager (EDITOR) directly oversees (legacy/manual assignment).
  managedDoctors Doctor[] @relation("ManagerDoctors")
  // Cities this manager (EDITOR) is assigned — grants visibility into all
  // doctors and patients within them (the primary assignment mechanism).
  managedCities City[] @relation("ManagerCities")
  contentPosts  ContentPost[]

  @@map("admins")
}

enum AdminRole {
  SUPERADMIN
  EDITOR
}

// ---------------------------------------------------------------------------
// Medication catalog + titration (Semetra-first)
// ---------------------------------------------------------------------------

model Medication {
  id           String  @id @default(uuid())
  name         String  // e.g. "Semetra"
  genericName  String? // e.g. "Semaglutide"
  manufacturer String? // e.g. "Petra Pharma"
  isTitrated   Boolean @default(false)

  pens Pen[]

  @@unique([name])
  @@map("medications")
}

// A physical pen in a titration course (e.g. "First Pen (1.5 ml)").
model Pen {
  id           String @id @default(uuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  label        String  // "First Pen (1.5 ml)"
  sequence     Int     // 1, 2, ...
  volumeMl     Float?

  weeks TitrationWeek[]

  @@unique([medicationId, sequence])
  @@map("pens")
}

// One row per week of the titration schedule (dose escalates across weeks).
model TitrationWeek {
  id         String @id @default(uuid())
  penId      String
  pen        Pen    @relation(fields: [penId], references: [id], onDelete: Cascade)
  weekNumber Int    // 1..N within the pen
  doseMg     Float  // 0.25, 0.50, ...

  @@unique([penId, weekNumber])
  @@map("titration_weeks")
}

// A user enrolling in a medication (their personal course start date).
model UserMedication {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationId String
  // Free-text fields also support non-titrated meds per the generic spec.
  name         String
  dosage       String?
  frequency    String?  // e.g. "weekly"
  timeOfDay    String?  // "HH:mm" for the local reminder
  startDate    DateTime @default(now())
  // Which pen the patient started at (1=First Pen, 2=Second Pen) — lets
  // someone mid-course skip the weeks they've already completed.
  startPenSequence Int  @default(1)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  doseLogs DoseLog[]

  @@index([userId])
  @@map("user_medications")
}

// A single administration event — the checkbox on the titration grid.
model DoseLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMedicationId String
  userMedication   UserMedication @relation(fields: [userMedicationId], references: [id], onDelete: Cascade)
  scheduledFor     DateTime // the week/day this dose belongs to
  takenAt          DateTime @default(now())
  doseMg           Float?
  note             String?

  @@index([userId, scheduledFor])
  @@map("dose_logs")
}

// ---------------------------------------------------------------------------
// Weight tracking
// ---------------------------------------------------------------------------

model WeightEntry {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float
  recordedAt DateTime @default(now())
  note       String?

  @@index([userId, recordedAt])
  @@map("weight_entries")
}

// ---------------------------------------------------------------------------
// Training & News — admin-published content, localized per language.
// ---------------------------------------------------------------------------

enum ContentType {
  NEWS
  TRAINING
}

model ContentPost {
  id          String      @id @default(uuid())
  type        ContentType

  titleEn String
  titleAr String?
  titleKu String?

  bodyEn String?
  bodyAr String?
  bodyKu String?

  // YouTube (or other embeddable) video links, per language.
  videoUrlEn String?
  videoUrlAr String?
  videoUrlKu String?

  // External image URLs (no upload pipeline — admin pastes hosted links).
  photoUrls String[] @default([])

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String?
  author   Admin?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([type, publishedAt])
  @@map("content_posts")
}

// ---------------------------------------------------------------------------
// Pharmacy directory (admin-managed, patient "near me" finder)
// ---------------------------------------------------------------------------

model Pharmacy {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  latitude  Float
  longitude Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pharmacies")
}
